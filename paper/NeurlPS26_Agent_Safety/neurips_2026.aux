\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces A multi-agent harness decomposes a user goal into subtasks executed by role-specialized agents. Safety failures can originate at any agent boundary: unauthorized tool calls, out-of-scope resource access, or sensitive data leaking across roles.}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:intro_motivation}{{2}{7}{A multi-agent harness decomposes a user goal into subtasks executed by role-specialized agents. Safety failures can originate at any agent boundary: unauthorized tool calls, out-of-scope resource access, or sensitive data leaking across roles}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Research Questions}{7}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{RQ1: Safety-Capability Trade-off.}{7}{section*.28}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main results across three evaluation layers. \textbf  {Layer\,1} (Protocol Safety) reports per-channel safety adherence rates: $\mathrm  {SAR}^{t}$ (tool), $\mathrm  {SAR}^{r}$ (resource), $\mathrm  {SAR}^{f}$ (information flow). Each cell shows the severity-weighted penalty score, with the recall-based score in parentheses. \textbf  {Layer\,2} reports OGS (Operational Governance Score) and TSR (Task Success Rate). \textbf  {Layer\,3} reports perturbation stability scores: indirect injection (\textbf  {Inj}), ambiguous goal (\textbf  {Amb}), and robustness test (\textbf  {Rob}). $\textbf  {SCR} = \overline  {\mathrm  {SAR}} \times \mathrm  {TSR}$. Higher is better for all metrics.}}{8}{table.caption.26}\protected@file@percent }
\newlabel{tab:main_results}{{2}{8}{Main results across three evaluation layers. \textbf {Layer\,1} (Protocol Safety) reports per-channel safety adherence rates: $\mathrm {SAR}^{t}$ (tool), $\mathrm {SAR}^{r}$ (resource), $\mathrm {SAR}^{f}$ (information flow). Each cell shows the severity-weighted penalty score, with the recall-based score in parentheses. \textbf {Layer\,2} reports OGS (Operational Governance Score) and TSR (Task Success Rate). \textbf {Layer\,3} reports perturbation stability scores: indirect injection (\textbf {Inj}), ambiguous goal (\textbf {Amb}), and robustness test (\textbf {Rob}). $\textbf {SCR} = \overline {\mathrm {SAR}} \times \mathrm {TSR}$. Higher is better for all metrics}{table.caption.26}{}}
