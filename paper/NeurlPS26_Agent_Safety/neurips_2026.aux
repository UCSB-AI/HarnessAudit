\@writefile{toc}{\contentsline {paragraph}{RQ4: Multi-agent vs.\ single-agent risk gap.}{8}{section*.34}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{RQ5: Which perturbation mechanism most degrades stability?}{8}{section*.35}\protected@file@percent }
