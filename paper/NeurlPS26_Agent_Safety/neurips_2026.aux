\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Safety--capability trade-off. Each point represents a (model, harness) configuration. Higher task completion (TSR) is associated with lower protocol safety (SAR), revealing that models achieve higher completion rates through more aggressive tool and resource usage.}}{9}{figure.caption.29}\protected@file@percent }
\newlabel{fig:rq1_tradeoff}{{6}{9}{Safety--capability trade-off. Each point represents a (model, harness) configuration. Higher task completion (TSR) is associated with lower protocol safety (SAR), revealing that models achieve higher completion rates through more aggressive tool and resource usage}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Safety channel decomposition. $\mathrm  {SAR}^{r}$ (resource scope) is consistently the weakest channel across all models, accounting for the majority of Layer\,1 failures. $\mathrm  {SAR}^{f}$ (information flow) is the strongest, indicating that inter-agent communication is relatively well controlled.}}{9}{figure.caption.31}\protected@file@percent }
\newlabel{fig:rq2_channels}{{7}{9}{Safety channel decomposition. $\mathrm {SAR}^{r}$ (resource scope) is consistently the weakest channel across all models, accounting for the majority of Layer\,1 failures. $\mathrm {SAR}^{f}$ (information flow) is the strongest, indicating that inter-agent communication is relatively well controlled}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Matched harness effect. For each model evaluated on the same set of tasks, switching the harness (e.g., Claude Code $\to $ OpenClaw) substantially shifts both SAR and TSR. The harness is a first-class safety variable, not merely an implementation detail.}}{10}{figure.caption.33}\protected@file@percent }
\newlabel{fig:rq3_harness}{{8}{10}{Matched harness effect. For each model evaluated on the same set of tasks, switching the harness (e.g., Claude Code $\to $ OpenClaw) substantially shifts both SAR and TSR. The harness is a first-class safety variable, not merely an implementation detail}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Perturbation stability by attack type. Indirect prompt injections cause the steepest safety degradation, while robustness tests (contradictory/empty tool returns) are better tolerated. Ambiguous goals occupy the middle ground.}}{10}{figure.caption.36}\protected@file@percent }
\newlabel{fig:rq5_perturbation}{{9}{10}{Perturbation stability by attack type. Indirect prompt injections cause the steepest safety degradation, while robustness tests (contradictory/empty tool returns) are better tolerated. Ambiguous goals occupy the middle ground}{figure.caption.36}{}}
