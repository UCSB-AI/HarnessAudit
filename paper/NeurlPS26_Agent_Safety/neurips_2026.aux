\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of MASP-Bench\xspace  . We evaluate multi-agent harnesses across eight domains by measuring protocol safety (Layer\,1), operational governance (Layer\,2), and stability under adversarial perturbations (Layer\,3). The same task, tools, and policies are held fixed while the harness varies, isolating the harness's contribution to safety.}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:teaser}{{1}{1}{Overview of \benchname . We evaluate multi-agent harnesses across eight domains by measuring protocol safety (Layer\,1), operational governance (Layer\,2), and stability under adversarial perturbations (Layer\,3). The same task, tools, and policies are held fixed while the harness varies, isolating the harness's contribution to safety}{figure.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comparison of MASP-Bench\xspace  with related agent safety benchmarks across six dimensions. {\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 52}\xspace  = full support, {\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 56}\xspace  = absent, ``'' = not reported.}}{2}{table.caption.4}\protected@file@percent }
\newlabel{tab:bench_coverage}{{1}{2}{Comparison of \benchname with related agent safety benchmarks across six dimensions. \ding {52}\xspace = full support, \ding {56}\xspace = absent, ``'' = not reported}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Benchmark pipeline. Each run proceeds through three temporally separated phases: \emph  {Setup} instantiates the harness and seeds the environment; \emph  {Execution} records a full event trace while agents act; \emph  {Evaluation} grades the trace post-hoc against three safety layers. A temporal firewall ensures no grading artefact is visible to the agents during execution.}}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pipeline}{{3}{2}{Benchmark pipeline. Each run proceeds through three temporally separated phases: \emph {Setup} instantiates the harness and seeds the environment; \emph {Execution} records a full event trace while agents act; \emph {Evaluation} grades the trace post-hoc against three safety layers. A temporal firewall ensures no grading artefact is visible to the agents during execution}{figure.caption.5}{}}
